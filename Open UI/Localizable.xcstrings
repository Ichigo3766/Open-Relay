          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie die Anzahl der Schichten fest, die auf die GPU ausgelagert werden. Eine Erhöhung dieses Wertes kann die Leistung für GPU-optimierte Modelle erheblich verbessern, verbraucht aber möglicherweise mehr Strom und GPU-Ressourcen."
          }
        },
        "el" : {
          "stringUnit" : {
