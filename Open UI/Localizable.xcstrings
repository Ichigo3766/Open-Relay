    "Channels are collaborative spaces where users and AI models can interact together." : {
      "comment" : "Description of the channels feature in the empty state",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القنوات هي مساحات للتعاون بين المستخدمين والموديلات الذكية"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanallar istifadəçilərlə AI modellərinin birlikdə işlədikləri yerdir"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каналите са съвместни пространства, където потребители и AI модели могат да взаимодействат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চ্যানেল হলো কোলাবোরেটিভ স্পেস যেখানে ইউজার আর AI একসাথে কাজ করতে পারে"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "སྟེགས་ཚད་དེ་སྒེར་གྲོགས་པའི་ས་གནས་ཡིན་ལ། མི་དང་AI དཔེ་མ་དག་ལྷན་སྟེགས་བྱེད་ཀྱི་ཡོད།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanali su mesta gde korisnici i AI mogu zajedno da komuniciraju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els canals són espais col·laboratius on els usuaris i els models d'IA poden interactuar junts."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Channels ay collaborative spaces kung saan users at AI models ay maaaring mag-interact together."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanály jsou místa ke spolupráci, kde se uživatelé a AI modely mohou spolu interagovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanaler er samarbejdssteder hvor brugere og AI-modeller kan interagere sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanäle sind Zusammenarbeitsflächen, in denen Nutzer und KI-Modelle zusammen interagieren können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κανάλια είναι συνεργατικοί χώροι όπου χρήστες και μοντέλα AI μπορούν να αλληλεπιδρούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channels are collaborative spaces where users and AI models can interact together."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channels are collaborative spaces where users and AI models can chat and interact together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales son espacios colaborativos donde usuarios y modelos de IA pueden interactuar juntos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalid on koostöörumid, kus kasutajad ja AI mudelid saavad koos suhtleda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanalak erabiltzaile eta AI modeloak batera elkarreragiten duten espazio kolaboratiboak dira."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کانال‌ها جاهایی هستن که کاربرها و هوش مصنوعی می‌تونن باهم کار کنن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanavat ovat yhteistyötiloja, joissa käyttäjät ja tekoäly-mallit voivat olla vuorovaikutuksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les canaux sont des espaces collaboratifs où les utilisateurs et les modèles IA peuvent interagir."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les canaux sont des espaces collaboratifs où les utilisateurs et les modèles IA peuvent interagir ensemble."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is spásanna comhoibríocha iad Chainéil inar féidir le húsáideoirí agus samhlacha AI idirghníomhú le chéile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais son espazos colaborativos onde usuarios e modelos de IA pueden interactuar xuntos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערוצים הם מרחבים שיתופיים שבהם משתמשים ו-AI יכולים לתקשר ביחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चैनल्स वो जगहें हैं जहां यूजर्स और AI मॉडल्स एक साथ बात कर सकते हैं।"
