    "Swipe left on a model row to delete it from disk and free storage." : {
      "comment" : "Instruction footer for model storage management section",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرر لليسار على صف نموذج لحذفه من الجهاز وتحرير مساحة"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modeli silmə üçün sürüşdür, yaddaş boşalıb"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзни наляво модела, за да го изтриеш и освободиш място."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মডেল ডিলিট করতে বাম দিকে সোয়াইপ করো, স্টোরেজ খালি হবে"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "མདེལ་གཞི་གཅིག་གི་ལ་གཡོན་པོར་བདེ་བར་སྤོར་ཞིང་། ཁོ་མ་ལ་གོ་གོ་གཏོང་།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povuci ulijevo na model da ga obrišeš sa diska i oslobodiš prostor"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca a l'esquerra en una fila de model per eliminar-lo del disc i alliberar espai"
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
