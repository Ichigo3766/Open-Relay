          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاتىرalarي AI نىڭ سىز توغرىسىدىكى مۈھىم مەزمۇننى سۆھبەتلەردە ئەسلەشىگە ياردەملەيدۇ. باشلاشقا خاتىرە قوشۇڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спогади допомагають ШІ запам'ятовувати про тебе. Додай спогад щоб почати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میموریز AI کو آپ کے بارے میں اہم باتیں یاد رکھنے میں مدد دیتی ہیں۔ شروع کرنے کے لیے ایک میموری شامل کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xotiralar AI-ga siz haqida muhim kontekstni suhbatlar davomida eslab qolishga yordam beradi. Boshlash uchun xotira qo'shing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký ức giúp AI nhớ những thông tin quan trọng về bạn qua các cuộc chat. Thêm ký ức để bắt đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆帮助AI在聊天中记住关于你的重要信息。添加一条记忆来开始吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶幫 AI 記住你的重要背景。新增一個記憶開始吧。"
          }
        }
      }
