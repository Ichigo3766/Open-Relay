        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour l'entrée micro en direct. Le framework Speech d'Apple fonctionne hors ligne sans données envoyées aux serveurs externes."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gcum ionchur micreafóin bheo. Oibríonn fuaimchóras Cainte Apple gan idirlíon - gan sonraí a sheoladh."
