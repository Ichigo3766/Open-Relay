    "Upload a file using the button above, or all files are already attached." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفّع ملف من الزر اللي فوق، أو الملفات كلها موصولة بالفعل"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuxarıdakı düyməni istifadə edərək fayl yüklə, ya da bütün fayllar artıq əlavə olunub"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Качи файл със бутона горе или всичко е вече качено"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উপরের বাটন ব্যবহার করে ফাইল আপলোড করুন, নতুবা সব ফাইল ইতিমধ্যে যুক্ত আছে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "སྐུ་མཐོང་སྣོན་གཏུབ༏ ཡང་ན་ཀུན་དགོ་སྦེ་ཡིན།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Učitaj datoteku s dugmeta gore ili su sve već dodane."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puja un fitxer amb el botó de dalt, o tots ja estan adjunts."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-upload ang file gamit ang button, o lahat ng files ay attached na."
