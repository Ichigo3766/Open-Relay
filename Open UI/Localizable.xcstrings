    "Please check your internet connection and try again. Make sure your server is reachable." : {
      "comment" : "Error description for network errors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من الإنترنت والحاول مرة ثانية. تأكد إن السيرفر شغّال."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantınızı yoxlayın və yenidən cəhd edin. Serverin əlçatan olduğundan əmin olun."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провери интернет и опитай отново. Уверени се че сървърът е достъпен."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট কানেকশন চেক করো এবং আবার চেষ্টা করো। সার্ভার পৌঁছানো যাচ্ছে কিনা দেখো।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཡར་སྟེགས་མཐུད་ལམ་བལྟ་ལ་སླར་འདེགས་རོགས། སེར་ཕུ་དུ་སྲེད་ཐུབ་པ་ངེས་པ།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjeri internet konekciju i pokušaj ponovno. Provjeri je li server dostupan."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova la connexió a internet i torna-ho a intentar. Assegura't que el servidor és accessible."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tignan ang internet mo at try ulit. Siguruhing connected ang server"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontroluj si internet a zkus to znovu. Ujisti se, že tvůj server je dostupný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek din internetforbindelse og prøv igen. Sørg for at serveren er tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte überprüfe deine Internetverbindung und versuche es erneut. Stelle sicher, dass dein Server erreichbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγχε τη σύνδεσή σου και δοκίμασε ξανά. Βεβαιώσου ότι ο σερβέρ είναι προσβάσιμος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please check your internet connection and try again. Make sure your server is reachable."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please check your internet connection and try again. Make sure your server is reachable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica tu conexión a internet e intenta de nuevo. Asegúrate de que tu servidor esté alcanzable."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolli interneti ühendust ja proovi uuesti. Veendu, et server on kättesaadav."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egiaztatu zure internet konexioa eta saiatu berriro. Ziurtatu zure zerbitzaria irista daitekeela."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصال اینترنت رو چک کن و دوباره سعی کن. مطمئن شو سرور دسترسی‌پذیر است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista internetyhteytesi ja yritä uudelleen. Varmista, että palvelimesi on tavoitettavissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie ta connexion internet et réessaie. Assure-toi que ton serveur est accessible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie ta connexion Internet et réessaie. Assure-toi que ton serveur est accessible."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiceáil do nasc idirlín le do thoil agus déan iarracht arís. Bí cinnte go bhfuil do fhreastalaí inrochtana."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comproba a túa conexión a internet e proba de novo. Asegúrate de que o teu servidor é accesible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדוק את חיבור האינטרנט שלך וחזור לנסות. ודא שהשרת שלך זמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना इंटरनेट कनेक्शन चेक करो और फिर से ट्राई करो। देख कि सर्वर काम कर रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjeri internetsku vezu i pokušaj ponovno. Provjeri je li server dostupan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizd az internetkapcsolatod, és próbáld újra. Biztosítsd, hogy a szervered elérhető."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolong cek koneksi internet lu dan coba lagi. Pastiin server lu bisa dijangkau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la tua connessione internet e riprova. Assicurati che il tuo server sia raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認してもう一度試してください。サーバーが到達可能か確認してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეამოწმე ინტერნეტი და ხელახლა სცადე. დარწმუნდი რომ სერვერი ხელმისაწვდომი."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma ulac ara, wali taɣult internet-ik, issin-iyi-d. Uqel-ak server ik izmir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결 확인하고 다시 시도해 봐. 서버에 접속 가능한지 확인해 줘."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patikrinkite interneto ryšį ir bandykite dar kartą. Įsitikinkite, kad serveris prieinamas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudī interneta savienojumu un mēģini vēlreiz. Pārliecinies, ka tavs serveris ir pieejams."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa sambungan internet kamu dan coba lagi. Pastikan server kamu bisa dijangkau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk internettforbindelsen din og prøv igjen. Kontroller at serveren er tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je internetverbinding en probeer opnieuw. Zorg dat je server bereikbaar is."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਇੰਟਰਨੇਟ ਕਨੈਕਸ਼ਨ ਚੈਕ ਕਰ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰ। ਪੱਕਾ ਕਰ ਕਿ ਸਰਵਰ ਪਹੁੰਚਯੋਗ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie internetowe i spróbuj ponownie. Upewnij się, że serwer jest dostępny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica sua conexão com a internet e tenta de novo. Certifica que seu servidor tá acessível."
