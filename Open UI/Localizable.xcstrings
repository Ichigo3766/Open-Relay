        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더블 탭으로 열고, 드래그해서 폴더 간 이동해"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kartus paspaudyk atidarymui. Tempk tarp aplankų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divas reizes pieskarieties, lai atvērtu. Velciet, lai pārvietotu starp mapēm"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dua kali buka. Seret untuk gerak antara folder"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttrykk for å åpne. Dra for å flytte mellom mapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik om te openen. Sleep om tussen mappen te verplaatsen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਦੋ ਟੈਪ ਕਰ ਖੋਲ਼ਣ ਲਈ। ਫੋਲਡਰਾਂ ਵਿਚ ਲਿਜਾਣ ਲਈ ਖਿੱਚ।"
          }
        },
        "pl" : {
