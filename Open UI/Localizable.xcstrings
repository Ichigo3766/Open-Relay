    "HTTP headers sent with every request to this server. Useful for reverse proxies or services that require extra authentication headers." : {
      "comment" : "A description of the custom headers section in the server management view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP headers توترسل مع كل طلب. مفيدة للـ proxies أو الخدمات الي تحتاج headers إضافية"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu serverə hər sorğu ilə göndərilən HTTP başlıqları. Tərsinə vəkillər və ya əlavə autentifikasiya başlıqlarına ehtiyac duyulan xidmətlər üçün faydalı."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP headers, които се изпращат със всяко запитване до този сървър. Полезни за обратни прокси или услуги, които изискват допълнителни headers за удостоверяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সার্ভারে প্রতিটা রিকোয়েস্টের সাথে পাঠানো এইচটিটিপি হেডার। রিভার্স প্রক্সি বা এক্সট্রা অথেন্টিকেশন দরকার এমন সেবার জন্য কাজে লাগে"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP headers གཏུབ་སྲིད། reverse proxy ཡང་ན་ authentication དགོས་པའི་སེམས།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP zaglavlja koja se šalju sa svakim zahtjevom na ovaj server. Korisno za obrnute proxy-je ili usluge koje trebaju dodatna zaglavlja za autentifikaciju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capçaleres HTTP per a cada sol·licitud. Útil per a proxys inverses o serveis amb autenticació extra."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP headers na ipinapadala sa bawat request. Useful para sa reverse proxies o services na may extra authentication."
          }
        },
        "cs" : {
