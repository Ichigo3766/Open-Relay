          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এই কথোপকথন থেকে মেসেজ পাবেন না। এটা আপনার সাইডবার থেকে লুকানো হবে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
