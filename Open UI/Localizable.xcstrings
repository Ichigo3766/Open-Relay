    "Used for live microphone input. Apple's Speech framework works offline with no data sent to external servers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإدخال من الميك الحي. تقنية Apple للكلام تشتغل بلا إنترنت ما تبعت بيانات لسيرفرات برّا"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mikrofon girişi üçün istifadə olunur. Apple Speech framework oflayn işləyir, heç bir məlumat xarici serverlərə göndərilmir"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За живо микрофонно вход. Apple Speech работи офлайн без да праща данни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইভ মাইক্রোফোন ইনপুটের জন্য ব্যবহৃত হয়। অ্যাপলের স্পিচ ফ্রেমওয়ার্ক অফলাইনে কাজ করে, কোনো ডেটা বাইরের সার্ভারে পাঠানো হয় না।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone ནས་གི་སྒྲ་ཆེས༏ Apple གི་Speech framework ལ་ཨེ་མེ་དེ་མེད་པའི་དེང་གི་ཡིན།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za mikrofon. Apple Speech radi offline bez slanja podataka vanjskim serverima."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a entrada de micròfon en directe. El Speech d'Apple funciona sense connexió sense enviar dades a externs."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa live microphone input. Offline ang Apple's Speech framework at walang data papunta sa external servers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se pro vstup z mikrofonu. Apple Speech framework funguje offline bez odesílání dat na externí servery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til live-mikrofoninput. Apples Speech-framework fungerer offline uden at sende data til eksterne servere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Live-Mikrofoneingaben genutzt. Apples Speech-Framework funktioniert offline, ohne Daten an externe Server zu senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για live microphone input. Το Speech framework της Apple δουλεύει offline χωρίς να στέλνει δεδομένα σε εξωτερικούς servers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for live mic input. Apple's Speech framework works offline with no data sent to external servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para entrada de micrófono en vivo. El framework de voz de Apple funciona sin internet sin enviar datos a servidores externos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse reaalajas mikrofoni sisendiks. Apple Speech framework töötab võrguühenduseta, andmeid välistele servritele ei saadeta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonoa zuzenean entzuteko. Apple-ren Hitza martxan funtzionatzen du kanpoko zerbitzarietara datua bidaldu gabe"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای صدای میکروفن زنده استفاده میشه. Speech فریم‌ورک اپل آفلاین کار میکنه و هیچ اطلاعاتی به بیرون فرستاده نمیشه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään live-mikrofonin syötölle. Applen puheentunnistus toimii offline-tilassa ilman tietojen lähettämistä ulkoisille palvelimille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour l'entrée du microphone en direct. Le framework Speech d'Apple fonctionne hors ligne sans envoi de données à des serveurs externes."
