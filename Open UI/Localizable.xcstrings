    "Used for live microphone input. Sends audio to your OpenWebUI server for transcription. Requires internet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإدخال من الميك الحي. تبعت الصوت لسيرفر OpenWebUI عشان ينسخه. محتاج إنترنت"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mikrofon girişi üçün istifadə olunur. Səsi OpenWebUI serverinə transkripsiya üçün göndərir. İnternət tələb olunur"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За живо микрофонно вход. Праща аудио на твоя OpenWebUI за запис. Трябва интернет."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
