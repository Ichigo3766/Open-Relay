    "This will archive all your conversations. You can unarchive them later from the web interface." : {
      "comment" : "Confirmation message for archiving all conversations",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا بيؤرشف كل محادثاتك. بعدين تقدر تفك الأرشيف من الويب"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün söhbətlərin arxivləşəcək. Daha sonra vebdən aradan qaldıra bilərsən."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще архивира всички твои разговори. Можеш да ги разархивираш по-късно от уеб интерфейса."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সব কথোপকথন আর্কাইভ করবে। ওয়েব থেকে আনআর্কাইভ করতে পারবে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "འདི་ཁྱེད་ཀྱི་ལབ་དུས་མའ་ཀང་ལ་དགོ༏ མ་མི་ལ་གཏོན་ཐུབ།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će arhivirati sve tvoje razgovore. Možeš ih kasnije rasarhivirati iz web interfacea"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això arxivarà totes les teves converses. Pots desarxivar-les més tard des del web."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia-archive ang lahat ng iyong chats. Pwede mong i-unarchive sila later sa web."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivuje všechny tvoje konverzace. Později si je můžeš vrátit z webového rozhraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette arkiverer alle dine samtaler. Du kan arkivere dem senere fra websiden."
          }
        },
        "de" : {
