    "Create a custom model to wrap any base model with your own system prompt, capabilities, and settings." : {
      "comment" : "A description of the benefits of creating a custom model.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انشئ موديل مخصص يغطي أي موديل أساسي مع البرومبت والإمكانيات والإعدادات بتاعتك"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstənilən model üzərində öz sistem promptu, imkanları və ayarlarınızla custom model yarat."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създай персонализиран модел, за да обвиеш всеки базов модел със твой системен промпт, възможности и настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো বেস মডেলকে নিজের সিস্টেম প্রম্পট, ক্ষমতা আর সেটিংস দিয়ে ওয়ার্যাপ করতে কাস্টম মডেল বানাও।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "རང་གི་ལུགས་ཀྱི་རྣམ་གཞག་དང་གླེང་སྐུལ་སྐུར་བའི་རྣམ་གཞག་སྐུར།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreiraj prilagođeni model da omotaš bilo koji osnovni model sa sopstvenim systemskim promptom, mogućnostima i postavkama."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un model personalitzat per embolcallar qualsevol model base amb el teu propi system prompt, capacitats i configuració."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumikha ng custom model para i-wrap ang base model gamit ang iyong system prompt, capabilities, at settings"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoř vlastní model, aby sis zabalit jakýkoli základní model s vlastním systémovým promptem, možnostmi a nastavením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav en custom model til at wrappe en base model med dit eget system prompt, muligheder og indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein benutzerdefiniertes Modell, um jedes Basis-Modell mit deinem eigenen System-Prompt, Fähigkeiten und Einstellungen zu erweitern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε ένα προσαρμοσμένο μοντέλο για να περιτυλίξετε οποιοδήποτε βασικό μοντέλο με τη δική σας προτροπή συστήματος, δυνατότητες και ρυθμίσεις."
          }
