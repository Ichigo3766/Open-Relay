        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორჯერ შეეხეთ გახსნისთვის. გადაიტანეთ ფოლდერებს შორის."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sken sin iwakken ad tebdu. Ader iwakken ad d-aγref."
