        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá URL serveru si drží jednu session. Chceš-li na stejném serveru jiný účet, přepni si na něj a nejdřív se odhlašs."
          }
        },
        "da" : {
          "stringUnit" : {
