        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bekapcsolt, az érvelési blokkok kitárolódnak, miközben a modell gondolkodik, és összecsukódnak, ha kész. Ha kikapcsolt, összecsukott állapotban maradnak"
