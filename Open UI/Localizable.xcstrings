    "Double tap to open. Drag to move between folders." : {
      "comment" : "Accessibility hint for a drawer row.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين عشان تفتح. اسحب عشان تنقل بين الفولدرز"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açmaq üçün iki dəfə toxun. Folderlərin arasında hərəkit etmək üçün sürüklə."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двойно докосни за отваряне. Плъзни, за да преместиш между папки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুইবার ট্যাপ করলে খুলবে। ফোল্ডারের মধ্যে সরাতে ড্র্যাগ করো।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཁ་གཉིས་ཏན་དུ། ལེབ་དུ་སྨིན་ནི།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvostruki dodir za otvaranje. Povlačenje za premještanje između mapa."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dues vegades per obrir. Arrossega per moure entre carpetes."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-double tap para ablihin. I-drag para ilipat sa iba't ibang folders."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poklepej na otevření. Přetáhni mezi složkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttryk for at åbne. Træk for at flytte mellem mapper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelt tippen zum Öffnen. Ziehen zum Verschieben zwischen Ordnern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για να ανοίξετε. Σύρετε για να μετακινήσετε μεταξύ φακέλων."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double tap to open. Drag to move between folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para abrir. Arrastra para mover entre carpetas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topelt-puuduta avatamiseks. Lohistamine kaustad vahel liigutamiseks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik bikoitza irekitzeko. Arrastatu karpetak artean mugitzeko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دو بار ضربه کن تا باز شود. بکش تا بین فولدرها جابه‌جا شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kahdesti avataksesi. Vedä siirtääksesi kansioiden välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-clique pour ouvrir. Glisse pour déplacer entre les dossiers"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tape pour ouvrir. Glisse pour déplacer entre les dossiers."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cnag dhúbailte chun oscailt. Tarraing chun gluaiseachán idir fhillteáin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dúas veces para abrir. Arrastra para mover entre cartafoles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש פעמיים כדי לפתוח. גרור כדי להעביר בין תיקיות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोलने के लिए डबल टैप करो। फोल्डर्स के बीच घुमाने के लिए ड्रैग करो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvostruko dotakni da otvoriš. Povuci da pomakneš između mapa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints kétszer hogy megnyisd. Húzd hogy mappaközt mozgasd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double tap buat buka. Geser buat pindahin antar folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per aprire. Trascina per spostare tra le cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップで開く。ドラッグでフォルダ間を移動"
