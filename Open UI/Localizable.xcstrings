    "Got an idea? We'd love to hear it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك فكرة؟ نود أن نسمعها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fikrin var? Onu eşitmək istərdik."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имате идея? Ще се радваме да я слушаме."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো আইডিয়া আছে? আমরা শুনতে চাই।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "བྱ་བའི་བསམ་ཚུལ་ཡོད་པ་རེད་ན། བདག་ཅག་ལ་ཉན་པར་འདོད་ཡོད།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imate ideju? Voljeli bismo je čuti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens una idea? Ens encantaria escoltar-la."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May idea ka? Gusto naming marinig."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte nápad? Rádi ho uslyšíme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du en ide? Vi vil gerne høre den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du eine Idee? Wir würden sie gerne hören."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις μια ιδέα; Θα χαιρόμαστε να την ακούσουμε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got an idea? We'd love to hear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes una idea? Nos encantaría escucharla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kas teil on idee? Meile meeldiks kuulda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideia bat duzu? Oso gustuko genuke entzutea."
          }
