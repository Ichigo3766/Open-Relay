    "Memories help the AI remember important context about you across conversations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذكريات تساعد الذكاء الاصطناعي على تذكر السياق المهم عنك في المحادثات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xatirələr AI-yə sən haqqında mühüm məlumatı söhbətlərdə yadında saxlamasına kömək edir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спомените помагат на AI да помни важния контекст за тебе в разговорите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মেমরি AI কে তোমার গুরুত্বপূর্ণ তথ্য সব কথোপকথনে মনে রাখতে সাহায্য করে।"
          }
        },
        "bo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "སེམས་དངོས་ནི་རྨེ་བ་དེ་ལ་ཁ་མཐོང་རྩོད་ཐུབ་བྱེད་ཡོད།"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspomene pomažu AI-u da pamti važan kontekst o tebi kroz razgovore."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les memòries ajuden la IA a recordar context important sobre tu en totes les converses."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang memories ay tumutulong sa AI na matandaan ang important context tungkol sa iyo sa lahat ng chats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paměti pomáhají AI pamatovat si důležitý kontext o tobě přes všechny konverzace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder hjælper AI'en med at huske vigtig kontekst om dig på tværs af samtaler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen helfen der KI, sich wichtige Informationen über dich über Gespräche hinweg zu merken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μνήμες βοηθούν το AI να θυμάται σημαντικό περιεχόμενο για σένα σε όλες τις συνομιλίες."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memories help the AI remember important context about you across conversations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las memorias ayudan a la IA a recordar contexto importante sobre ti en diferentes conversaciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mälu aitab AI-l meeles pidada olulisi detaile sinust erinevate vestluste vahel."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoriak AIari zure inguruko testuinguru garrantzitsua gogoratzeko laguntzen diote elkarrizketetan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یادآوری‌ها کمک میکنه AI نکات مهم درباره‌ت رو تو مکالمات یاد بگیره."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistot auttavat tekoälyä muistamaan tärkeitä asioita sinusta eri keskusteluissa."
          }
        },
        "fr" : {
