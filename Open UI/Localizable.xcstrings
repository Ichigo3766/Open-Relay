    "You'll stop receiving messages from this conversation. It will be hidden from your sidebar." : {
      "comment" : "Confirmation message for leaving a channel",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رح ما تستقبل رسايل من هالمحادثة. رح تكون مخفية من الشريط الجانبي"
