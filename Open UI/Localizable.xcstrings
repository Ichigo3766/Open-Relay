        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo se descarga de HuggingFace al usarlo por primera vez y se guarda localmente. Descargar libera memoria; eliminar borra la descarga."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudel laadib HuggingFace'ist esimesel korral ja salvestatakse lokaalselt. Üleslaadimine vabastab mälu; kustutamine eemaldab allalao."
